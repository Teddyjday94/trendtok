{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/main.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/main?__path=:path*" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "17 13 * * *" }
  ]
}
